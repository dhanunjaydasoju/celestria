# Copy to .env and fill in. .env is git-ignored and read only by the Node server.
# Never prefix secrets with VITE_ (that would put them in the browser bundle).

# ── Featherless AI (AI Astronomer, server only) ───────────────────────────
FEATHERLESS_API_KEY=
# Primary and fallback models (Qwen 3 family: native tool calling).
FEATHERLESS_MODEL=Qwen/Qwen3-32B
FEATHERLESS_FALLBACK_MODEL=Qwen/Qwen3-14B
# FEATHERLESS_BASE_URL=https://api.featherless.ai/v1

# ── AI usage limits and request budgets (defaults shown) ──────────────────
# AI_RATE_LIMIT_PER_MINUTE=10      # per client IP
# AI_RATE_LIMIT_PER_DAY=100        # per client IP
# AI_DAILY_REQUEST_BUDGET=500      # questions sent to the model per UTC day, whole server
# AI_DAILY_SPEND_LIMIT_USD=1       # whole server, per UTC day
# AI_COST_RESERVE_PER_CALL_USD=0.002
# AI_MAX_CONCURRENCY=1             # questions in flight at once (calls run one at a time)
# AI_MAX_QUEUE=4
# AI_QUEUE_TIMEOUT_MS=15000
# AI_MAX_TOOL_ROUNDS=6
# AI_MAX_TOOL_CALLS_PER_ROUND=8
# AI_MAX_OUTPUT_TOKENS=1200
# AI_PROMPT_TOKEN_BUDGET=24000     # keep below the model context (Qwen3: 32,768)
# AI_MAX_INPUT_CHARS=2000
# AI_MAX_HISTORY_TURNS=8
# AI_REQUEST_TIMEOUT_MS=90000      # whole question
# AI_CALL_TIMEOUT_MS=45000         # one Featherless call
# TRUST_PROXY=1                    # behind a hosting proxy: per-client limits use the real client IP
# AI_MAX_REPAIR_ATTEMPTS=2
# AI_CACHE_TTL_SECONDS=600

# ── Server ────────────────────────────────────────────────────────────────
# Dev API port (Vite proxies /api here). Production hosts set PORT themselves.
API_PORT=8787
# NASA_REFRESH=off

# ── NASA catalogue sync ───────────────────────────────────────────────────
# NASA_SYNC=on                     # 24-hourly sync with the NASA Exoplanet Archive (off: serve stored data only)
# NASA_DATA_DIR=                   # runtime catalogue folder (default server/data/runtime, git-ignored)
# Admin token for POST /api/sync/refresh and npm run data:sync. Server side
# only, at least 24 characters, e.g. from: openssl rand -hex 24
SYNC_ADMIN_TOKEN=
